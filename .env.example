# इस फ़ाइल को .env.local नाम से कॉपी करके अपनी असली values भरें। असली keys कभी GitHub पर न डालें।
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# केवल सर्वर के लिए। कभी NEXT_PUBLIC_ न लगाएँ।
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Vercel Cron सुरक्षा के लिए कोई लंबा random पासवर्ड
CRON_SECRET=long-random-string
# APIs (असली डॉक्स देखने के बाद ही उपयोग होंगे)
NAVAMSHA_API_KEY=
ASTROLOGICS_API_KEY=
# भुगतान (अभी खाली रखें, प्रदाता तय होने के बाद)
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
